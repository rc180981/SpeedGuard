rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi data pelanggaran kecepatan
    match /violations/{violationId} {
      allow read, write: if true; // Untuk produksi terproteksi, dapat disesuaikan dengan auth
    }
    
    // Koleksi akun petugas & admin (opsional jika disimpan di Firestore)
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
